{
  "$schema": "/Users/ryantseng/.claude/skills/awwwards-motion/scripts/scroll-spec.schema.json",
  "specVersion": 1,
  "viewport": {
    "width": 1440,
    "height": 900,
    "dpr": 2,
    "colorScheme": "light",
    "reducedMotion": "no-preference"
  },
  "scroll": {
    "totalHeightPx": 9504,
    "totalHeightTolerancePx": 400,
    "scrollAccuracyTolerancePx": 4,
    "sampleMatchWindow": 0.01,
    "allowSceneOverlap": false,
    "coverage": {
      "require": "full",
      "maxGapProgress": 0.005
    }
  },
  "settleMinMs": 0,
  "settleMaxMs": 2500,
  "name": "mediatastelibrary-argument-desktop",
  "url": "http://localhost:8811/",
  "description": "The argument, in chapters. Every scrubbed effect derives from one scrubbed proxy tween (scrub 0.6) mapped against these ranges, measured from the built page: a scene starts when its section enters at 85% of the viewport and ends when the next one does. Two signature moments (the load: grid, count and 131 modules; the ink flip into 'What broke') are time/state-based and checked in verify.sh, not here.",
  "positions": [
    0,
    0.0217,
    0.0434,
    0.0874,
    0.1314,
    0.1749,
    0.2184,
    0.3,
    0.3091,
    0.3998,
    0.492,
    0.5,
    0.5843,
    0.6858,
    0.7,
    0.7873,
    0.8937,
    0.9,
    1
  ],
  "targets": {
    "hero-count": "[data-motion='hero-count']",
    "method-walk": {
      "selector": "[data-motion='method-walk']",
      "vars": [
        "--walk"
      ]
    },
    "sheet": {
      "selector": "[data-motion='sheet']",
      "vars": [
        "--sheet"
      ]
    },
    "findings-mark": {
      "selector": "[data-motion='findings-mark']",
      "vars": [
        "--find"
      ]
    },
    "test-bars": {
      "selector": "[data-motion='test-bars']",
      "vars": [
        "--bars"
      ]
    },
    "glyphs": {
      "selector": "[data-motion='glyphs']",
      "vars": [
        "--draw"
      ]
    },
    "exhibit-dot": {
      "selector": "[data-motion='exhibit-dot']",
      "vars": [
        "--t"
      ]
    }
  },
  "scenes": [
    {
      "id": "hero",
      "label": "Hero — the count departs",
      "selector": "[data-scene='hero']",
      "range": {
        "from": 0,
        "to": 0.0434
      },
      "expectations": [
        {
          "id": "hero-count-departs",
          "target": "hero-count",
          "property": "translateY",
          "tolerance": 8,
          "monotonic": "decreasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "at rest"
            },
            {
              "localProgress": 1,
              "value": -60,
              "label": "departed"
            }
          ],
          "easeRef": "none — scrubbed",
          "monotonicEpsilon": 1
        }
      ]
    },
    {
      "id": "sweep",
      "label": "01 — the walk visits the six steps (held stops)",
      "selector": "[data-scene='sweep']",
      "range": {
        "from": 0.0434,
        "to": 0.1314
      },
      "expectations": [
        {
          "id": "sweep-walk",
          "target": "method-walk",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--walk",
          "note": "--walk drives offset-distance through measured marker positions; 60% travel / 40% hold per leg; markers fill as reached."
        }
      ]
    },
    {
      "id": "sheet",
      "label": "01 — the contact sheet, rows in award order",
      "selector": "[data-scene='sheet']",
      "range": {
        "from": 0.1314,
        "to": 0.2184
      },
      "expectations": [
        {
          "id": "sheet-sheet",
          "target": "sheet",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--sheet"
        }
      ]
    },
    {
      "id": "broke",
      "label": "02 — the thesis is underlined as it is read (ink ground)",
      "selector": "[data-scene='broke']",
      "range": {
        "from": 0.2184,
        "to": 0.3998
      },
      "expectations": [
        {
          "id": "broke-find",
          "target": "findings-mark",
