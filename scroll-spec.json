          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--t"
        }
      ]
    }
  ]
}