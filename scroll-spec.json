{
  "$schema": "/Users/ryantseng/.claude/skills/awwwards-motion/scripts/scroll-spec.schema.json",
  "specVersion": 1,
  "viewport": {
    "width": 1440,
    "height": 900,
    "dpr": 2,
    "colorScheme": "light",
    "reducedMotion": "no-preference"
  },
  "scroll": {
    "totalHeightPx": 11083,
    "totalHeightTolerancePx": 400,
    "scrollAccuracyTolerancePx": 4,
    "sampleMatchWindow": 0.01,
    "allowSceneOverlap": false,
    "coverage": {
      "require": "full",
      "maxGapProgress": 0.005
    }
  },
  "settleMinMs": 0,
  "settleMaxMs": 2500,
  "name": "mediatastelibrary-argument-desktop",
  "url": "http://localhost:8811/",
  "description": "The argument, in chapters. Scene ranges are measured from the built page: a scene starts when its section enters at 85% of the viewport and ends when the next one does. Within a scene each effect is scrubbed (a proxy tween, scrub 0.6) from its OWN element's entry to where it is done, so it is never half-drawn while readable. Two signature moments (the load: grid, count and 131 modules; the ink flip into 'What broke') are time/state-based and checked in verify.sh, not here.",
  "positions": [
    0,
    0.0319,
    0.0638,
    0.1103,
    0.1567,
    0.1963,
    0.236,
    0.3,
    0.3146,
    0.3932,
    0.4903,
    0.5,
    0.5874,
    0.6884,
    0.7,
    0.7894,
    0.8947,
    0.9,
    1
  ],
  "targets": {
    "hero-count": "[data-motion='hero-count']",
    "method-walk": {
      "selector": "[data-motion='method-walk']",
      "vars": [
        "--walk"
      ]
    },
    "sheet": {
      "selector": "[data-motion='sheet']",
      "vars": [
        "--sheet"
      ]
    },
    "findings-mark": {
      "selector": "[data-motion='findings-mark']",
      "vars": [
        "--find"
      ]
    },
    "test-bars": {
      "selector": "[data-motion='test-bars']",
      "vars": [
        "--bars"
      ]
    },
    "atlas": {
      "selector": "[data-motion='atlas']",
      "vars": [
        "--draw"
      ]
    },
    "exhibit-dot": {
      "selector": "[data-motion='exhibit-dot']",
      "vars": [
        "--t"
      ]
    }
  },
  "scenes": [
    {
      "id": "hero",
      "label": "Hero — the count departs",
      "selector": "[data-scene='hero']",
      "range": {
        "from": 0,
        "to": 0.0638
      },
      "expectations": [
        {
          "id": "hero-count-departs",
          "target": "hero-count",
          "property": "translateY",
          "tolerance": 8,
          "monotonic": "decreasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "at rest"
            },
            {
              "localProgress": 1,
              "value": -60,
              "label": "departed"
            }
          ],
          "easeRef": "none — scrubbed",
          "monotonicEpsilon": 1
        }
      ]
    },
    {
      "id": "sweep",
      "label": "01 — the walk visits the six steps (held stops)",
      "selector": "[data-scene='sweep']",
      "range": {
        "from": 0.0638,
        "to": 0.1567
      },
      "expectations": [
        {
          "id": "sweep-walk",
          "target": "method-walk",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--walk",
          "note": "--walk scrubs from the walk's own entry (top 85%) to its bottom at 75%, driving offset-distance through measured marker positions; 60% travel / 40% hold per leg; markers fill as reached."
        }
      ]
    },
    {
      "id": "sheet",
      "label": "01 — the contact sheet, rows in award order",
      "selector": "[data-scene='sheet']",
      "range": {
        "from": 0.1567,
        "to": 0.236
      },
      "expectations": [
        {
          "id": "sheet-sheet",
          "target": "sheet",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--sheet"
        }
      ]
    },
    {
      "id": "broke",
      "label": "02 — the thesis is underlined as it is read (ink ground)",
      "selector": "[data-scene='broke']",
      "range": {
        "from": 0.236,
        "to": 0.3932
      },
      "expectations": [
        {
          "id": "broke-find",
          "target": "findings-mark",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--find",
          "note": "--find scrubs from the thesis's own entry (top 85%) to its bottom at mid-viewport, so the clause is underlined while it is read. The 1,118 and the spec figures count ONCE on enter (time-based), so they are not scroll-asserted."
        }
      ]
    },
    {
      "id": "test",
      "label": "03 — score bars drawn to scale",
      "selector": "[data-scene='test']",
      "range": {
        "from": 0.3932,
        "to": 0.5874
      },
      "expectations": [
        {
          "id": "test-bars",
          "target": "test-bars",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--bars",
          "note": "Each [data-bars] block scrubs --bars from its own top at 90% to 55%; this asserts the first."
        }
      ]
    },
    {
      "id": "fams",
      "label": "04 — the ease atlas draws, row by row",
      "selector": "[data-scene='fams']",
      "range": {
        "from": 0.5874,
        "to": 0.7894
      },
      "expectations": [
        {
          "id": "fams-draw",
          "target": "atlas",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--draw",
          "note": "--draw scrubs from the atlas's own entry (top 85%) to its bottom at 85%; each plot draws over a quarter of that, offset by its place (--f)."
        }
      ]
    },
    {
      "id": "self",
      "label": "05 — the exhibit dot rides the page's own ease",
      "selector": "[data-scene='self']",
      "range": {
        "from": 0.7894,
        "to": 1
      },
      "expectations": [
        {
          "id": "self-t",
          "target": "exhibit-dot",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--t"
        }
      ]
    }
  ]
}