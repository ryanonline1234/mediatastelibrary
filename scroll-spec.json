{
  "$schema": "/Users/ryantseng/.claude/skills/awwwards-motion/scripts/scroll-spec.schema.json",
  "specVersion": 1,
  "name": "mediatastelibrary-home-desktop",
  "description": "The page performs its own spec. Five scenes; every scrubbed effect is driven from one scrubbed proxy tween (scrub 0.6, real), mapped against THESE ranges — measured from the built page: a scene starts when its section enters at 85% of the viewport and ends when the next one does. The first draft used estimates and the implementation mapped against the same estimates, so the assertions passed while the exhibit fired two sections early. Feel row: snappy/technical. Lenis lerp 0.15, power3.out reveals, monospace counters.",
  "url": "http://localhost:8811/",
  "viewport": {
    "width": 1440,
    "height": 900,
    "dpr": 2,
    "colorScheme": "light",
    "reducedMotion": "no-preference"
  },
  "scroll": {
    "totalHeightPx": 27748,
    "totalHeightTolerancePx": 400,
    "scrollAccuracyTolerancePx": 4,
    "sampleMatchWindow": 0.01,
    "allowSceneOverlap": false,
    "coverage": {
      "require": "full",
      "maxGapProgress": 0.005
    }
  },
  "settleMinMs": 0,
  "settleMaxMs": 2500,
  "positions": [
    0,
    0.0098,
    0.0196,
    0.0324,
    0.0453,
    0.0543,
    0.0634,
    0.0776,
    0.0917,
    0.3,
    0.5,
    0.5458,
    0.7,
    0.9,
    1
  ],
  "targets": {
    "hero-section": "[data-scene='hero']",
    "hero-count": "[data-motion='hero-count']",
    "method-section": "[data-scene='method']",
    "method-walk": {
      "selector": "[data-motion='method-walk']",
      "vars": [
        "--walk"
      ]
    },
    "findings-section": "[data-scene='findings']",
    "exhibit-section": "[data-scene='exhibit']",
    "exhibit-dot": {
      "selector": "[data-motion='exhibit-dot']",
      "vars": [
        "--t"
      ]
    },
    "families-section": "[data-scene='families']",
    "families-rail": {
      "selector": "[data-motion='families-rail']",
      "vars": [
        "--fam"
      ]
    },
    "findings-mark": {
      "selector": "[data-motion='findings-mark']",
      "vars": [
        "--find"
      ]
    }
  },
  "scenes": [
    {
      "id": "hero",
      "label": "Hero — the count departs",
      "selector": "[data-scene='hero']",
      "range": {
        "from": 0,
        "to": 0.0196
      },
      "expectations": [
        {
          "id": "hero-count-departs",
          "target": "hero-count",
          "property": "translateY",
          "tolerance": 8,
          "monotonic": "decreasing",
          "monotonicEpsilon": 1,
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "at rest, 264px rank"
            },
            {
              "localProgress": 1,
              "value": -60,
              "label": "departed"
            }
          ],
          "easeRef": "none — scrubbed. motion-priors §8 cross-cutting: scrubbed tweens are always ease:'none'.",
          "note": "The 264px count leaves slightly faster than the page. Load-time count-up (2.0s power3.inOut, Trionn odometer prior) is not scroll-driven and is checked as an invariant, not here."
        }
      ]
    },
    {
      "id": "method",
      "label": "Method — the marker walks the offset-path",
      "selector": "[data-scene='method']",
      "range": {
        "from": 0.0196,
        "to": 0.0453
      },
      "expectations": [
        {
          "id": "method-walk-progress",
          "target": "method-walk",
          "property": "cssVar",
          "cssVarName": "--walk",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start of path"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end of path"
            }
          ],
          "easeRef": "none — scrubbed",
          "note": "Drives offset-distance on the 8x8 square. swiss-grid-lab motion line, verbatim: 'travel via offset-path not transform'."
        }
      ]
    },
    {
      "id": "findings",
      "label": "Findings — the key sentence is highlighted as it is read",
      "selector": "[data-scene='findings']",
      "range": {
        "from": 0.0453,
        "to": 0.0634
      },
      "expectations": [
        {
          "id": "findings-highlight",
          "target": "findings-mark",
          "property": "cssVar",
          "cssVarName": "--find",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "unmarked"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "fully marked"
            }
          ],
          "easeRef": "none — scrubbed",
          "note": "The four counters beside it count ONCE on enter (time-based, 2s power3.inOut, stagger 0.1), so they are not scroll-asserted; this highlight is the scrubbed effect."
        }
      ]
    },
    {
      "id": "exhibit",
      "label": "Bezier exhibit — the page draws its own easing",
      "selector": "[data-scene='exhibit']",
      "range": {
        "from": 0.0634,
        "to": 0.0917
      },
      "expectations": [
        {
          "id": "exhibit-dot-travel",
          "target": "exhibit-dot",
          "property": "cssVar",
          "cssVarName": "--t",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "curve start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "curve end"
            }
          ],
          "easeRef": "none — scrubbed. The DOT is linear in scroll; the CURVE it rides is the eased shape, which is the whole exhibit.",
          "note": "The one signature moment. Handles and 8x8 markers drawn per swiss-grid-lab's sibling drafting kit."
        }
      ]
    },
    {
      "id": "families",
      "label": "Families — 43 sections, reading rail",
      "selector": "[data-scene='families']",
      "range": {
        "from": 0.0917,
        "to": 1
      },
      "expectations": [
        {
          "id": "families-rail-progress",
          "target": "families-rail",
          "property": "cssVar",
          "cssVarName": "--fam",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "first family"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "last family"
            }
          ],
          "easeRef": "none — scrubbed",
          "note": "Reading-progress rail across the 43-item index. Per-section reveals are enter-triggered (0.5s power3.out, stagger amount 0.4 — snappy row) and fire once; they are deliberately NOT scrubbed, so they are not asserted here."
        }
      ]
    }
  ]
}