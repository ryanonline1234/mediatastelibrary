              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--find",
          "note": "The 1,118 and the spec figures count ONCE on enter (time-based), so they are not scroll-asserted."
        }
      ]
    },
    {
      "id": "test",
      "label": "03 — score bars drawn to scale",
      "selector": "[data-scene='test']",
      "range": {
        "from": 0.3998,
        "to": 0.5843
      },
      "expectations": [
        {
          "id": "test-bars",
          "target": "test-bars",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
          "cssVarName": "--bars"
        }
      ]
    },
    {
      "id": "fams",
      "label": "04 — each family's own curve draws",
      "selector": "[data-scene='fams']",
      "range": {
        "from": 0.5843,
        "to": 0.7873
      },
      "expectations": [
        {
          "id": "fams-draw",
          "target": "glyphs",
          "property": "cssVar",
          "tolerance": 0.06,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0,
              "label": "start"
            },
            {
              "localProgress": 1,
              "value": 1,
              "label": "end"
            }
          ],
          "easeRef": "none — scrubbed",
