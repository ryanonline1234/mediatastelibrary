// Serves dist/ on the apex mediatastelibrary.page as an assets-only Worker.
// The domain's DNS lives on Cloudflare (R2 media is on media.mediatastelibrary.page),
// so the apex is served from Cloudflare too; a Workers Custom Domain creates its own
// DNS record and certificate. Deploy: `node build.mjs && npx wrangler deploy`.
{
  "name": "mediatastelibrary",
  "compatibility_date": "2026-09-24",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "mediatastelibrary.page", "custom_domain": true }],
  "workers_dev": false
}
